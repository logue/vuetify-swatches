{
  "name": "vuetify-swatches",
  "version": "2.3.0",
  "description": "Color Swatch component for Vuetify3.",
  "keywords": [
    "color-palette",
    "color-picker",
    "swatches",
    "vue",
    "vue-components",
    "vue-plugin",
    "vue3",
    "vuetify",
    "vuetify3"
  ],
  "homepage": "https://github.com/logue/vuetify-swatches",
  "bugs": {
    "url": "https://github.com/logue/vuetify-swatches/issues"
  },
  "license": "MIT",
  "author": {
    "name": "Logue",
    "email": "logue@hotmail.co.jp",
    "url": "https://logue.dev/"
  },
  "repository": {
    "type": "git",
    "url": "git@github.com:logue/vuetify-swatches.git"
  },
  "funding": [
    {
      "type": "github",
      "url": "https://github.com/sponsors/logue"
    },
    {
      "type": "ko-fi",
      "url": "https://ko-fi.com/logue"
    }
  ],
  "style": "dist/vuetify-swatches.css",
  "files": [
    "dist",
    "src/components/VSwatches.vue"
  ],
  "type": "module",
  "main": "dist/index.umd.js",
  "module": "dist/index.es.js",
  "browser": {
    "./sfc": "./src/components/VSwatches.vue"
  },
  "types": "dist/index.d.ts",
  "unpkg": "dist/index.iife.js",
  "jsdelivr": "dist/index.iife.js",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.es.js",
      "require": "./dist/index.cjs.js"
    },
    "./presets": {
      "types": "./dist/presets/index.d.ts",
      "import": "./dist/presets/index.js"
    },
    "./presets/basic": {
      "types": "./dist/presets/basic.d.ts",
      "import": "./dist/presets/basic.js"
    },
    "./presets/advanced": {
      "types": "./dist/presets/advanced.d.ts",
      "import": "./dist/presets/advanced.js"
    },
    "./umd": "./dist/index.umd.js",
    "./iife": "./dist/index.iife.js",
    "./dist/style.css": "./dist/vuetify-swatches.css",
    "./package.json": "./package.json"
  },
  "scripts": {
    "dev": "vp dev --open",
    "lint": "run-s lint:*",
    "lint:check": "vize lint --type-aware",
    "lint:oxlint": "vp lint --fix",
    "lint:oxfmt": "vp fmt",
    "build": "run-s build:lib build:presets",
    "build:lib": "run-p type-check build-only",
    "build:docs": "vp build --mode=docs",
    "build:presets": "vp build --config vite.config.presets.ts",
    "build:analyze": "vp build --mode analyze",
    "preview": "vp preview",
    "test": "vp test",
    "test:run": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:e2e": "playwright test",
    "clean": "rimraf dist",
    "clean:hard": "rimraf dist node_modules/.tmp node_modules/.vite node_modules/.vite-tmp",
    "build-only": "vp build",
    "type-check": "vize check --tsconfig tsconfig.app.json",
    "skills:install": "npx --no-install skills --version >/dev/null 2>&1 && npx skills experimental_install --yes || echo '\\033[1;33m⚠️  [Warning] skills command not found. Skipped auto-installation of agent skills.\\033[0m'",
    "skills:update": "npx skills update",
    "prepare": "vp config && pnpm run skills:install"
  },
  "dependencies": {
    "es-toolkit": "^1.53.2"
  },
  "devDependencies": {
    "@codemirror/lang-vue": "^0.1.3",
    "@eslint-community/eslint-plugin-eslint-comments": "^4.8.1",
    "@eslint/markdown": "^9.0.0",
    "@mdi/font": "^7.4.47",
    "@playwright/test": "^1.65.1",
    "@tsconfig/node-lts": "^26.0.1",
    "@types/jsdom": "^30.0.0",
    "@types/node": "^26.6.6",
    "@typescript/native": "npm:typescript@^7.0.2",
    "@vitejs/plugin-vue": "^6.0.11",
    "@vitest/coverage-v8": "catalog:",
    "@vue/test-utils": "^2.6.0",
    "@vue/tsconfig": "^0.9.1",
    "eslint-config-vuetify": "^4.7.2",
    "eslint-plugin-playwright": "^2.12.2",
    "eslint-plugin-security": "^4.2.1",
    "eslint-plugin-vuetify": "^2.7.3",
    "jsdom": "^31.0.1",
    "npm-run-all2": "^9.1.0",
    "rimraf": "^6.1.4",
    "rollup-plugin-visualizer": "^7.3.0",
    "sass-embedded": "^1.108.2",
    "taze": "^21.3.0",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "vite": "catalog:",
    "vite-plugin-banner": "^0.8.1",
    "vite-plugin-checker": "^1.1.0",
    "vite-plugin-dts": "^5.1.2",
    "vite-plugin-vue-devtools": "^8.2.1",
    "vite-plugin-vuetify": "^2.1.3",
    "vite-plus": "catalog:",
    "vitest": "catalog:",
    "vize": "^0.793.0",
    "vue-codemirror6": "^1.8.2"
  },
  "peerDependencies": {
    "vue": ">=3.5",
    "vuetify": ">=4"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "packageManager": "pnpm@12.23.0",
  "stackblitz": {
    "startCommand": "pnpm run test:unit"
  }
}
